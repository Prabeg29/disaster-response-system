<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.coit20258.drs.controller.DepartmentCoordinationController">

    <!-- ── Content header ──────────────────────────────────────────────── -->
    <HBox styleClass="content-header" alignment="CENTER_LEFT" spacing="16">
        <VBox spacing="2" HBox.hgrow="ALWAYS">
            <Label fx:id="headerDeptLabel"
                   text="Department"
                   styleClass="content-header-title"/>
            <Label fx:id="headerRoleLabel"
                   text="Department Coordinator"
                   styleClass="content-header-subtitle"/>
        </VBox>
        <Button text="Refresh"
                styleClass="btn-secondary"
                onAction="#handleRefresh"/>
    </HBox>

    <!-- ── Banner ──────────────────────────────────────────────────────── -->
    <Label fx:id="bannerLabel"
           wrapText="true"
           managed="false" visible="false"
           style="-fx-padding:8 28 8 28;"/>

    <!-- ── Main content: split pane ────────────────────────────────────── -->
    <SplitPane VBox.vgrow="ALWAYS" dividerPositions="0.55">

        <!-- LEFT: Assigned reports table -->
        <VBox styleClass="content-body" spacing="10">
            <padding><Insets top="16" right="12" bottom="16" left="16"/></padding>

            <Label text="ASSIGNED DISASTER REPORTS"
                   style="-fx-text-fill:#9ca3af; -fx-font-size:11px; -fx-font-weight:bold;"/>

            <TableView fx:id="reportsTable"
                       VBox.vgrow="ALWAYS"
                       styleClass="data-table">
                <columns>
                    <TableColumn fx:id="colType"     text="Type"     prefWidth="120"/>
                    <TableColumn fx:id="colLocation" text="Location" prefWidth="160"/>
                    <TableColumn fx:id="colSeverity" text="Severity" prefWidth="90"/>
                    <TableColumn fx:id="colStatus"   text="Status"   prefWidth="120"/>
                    <TableColumn fx:id="colAction"   text="Action"   prefWidth="90"/>
                </columns>
                <placeholder>
                    <Label text="No reports assigned to your department yet."
                           styleClass="table-placeholder"/>
                </placeholder>
            </TableView>

            <!-- Updates for selected report -->
            <Label text="RESPONSE UPDATES FOR SELECTED REPORT"
                   style="-fx-text-fill:#9ca3af; -fx-font-size:11px; -fx-font-weight:bold;
                          -fx-padding:12 0 0 0;"/>

            <TableView fx:id="updatesTable"
                       prefHeight="180"
                       styleClass="data-table">
                <columns>
                    <TableColumn fx:id="colUpdDept"   text="Department" prefWidth="130"/>
                    <TableColumn fx:id="colUpdStatus" text="Status"     prefWidth="110"/>
                    <TableColumn fx:id="colUpdText"   text="Update"     prefWidth="200"/>
                    <TableColumn fx:id="colUpdBy"     text="Posted By"  prefWidth="120"/>
                    <TableColumn fx:id="colUpdAt"     text="Time"       prefWidth="130"/>
                </columns>
                <placeholder>
                    <Label text="Select a report to see updates."
                           styleClass="table-placeholder"/>
                </placeholder>
            </TableView>
        </VBox>

        <!-- RIGHT: Post update form -->
        <VBox styleClass="form-panel" spacing="0" minWidth="300">
            <VBox styleClass="form-header" spacing="4">
                <padding><Insets top="16" right="20" bottom="16" left="20"/></padding>
                <Label text="Post Department Update" styleClass="form-title"/>
                <Label fx:id="selectedReportLabel"
                       text="No report selected"
                       styleClass="section-subtitle"
                       wrapText="true"/>
            </VBox>

            <VBox styleClass="form-body" spacing="16">
                <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

                <VBox spacing="6">
                    <Label text="Response Status" styleClass="field-label"/>
                    <ComboBox fx:id="responseStatusCombo"
                              styleClass="field-combo"
                              maxWidth="Infinity"
                              promptText="Select status…"/>
                </VBox>

                <VBox spacing="6" VBox.vgrow="ALWAYS">
                    <Label text="Update Details" styleClass="field-label"/>
                    <TextArea fx:id="updateTextArea"
                              styleClass="field-textarea"
                              promptText="Describe your department's current response actions, needs, or completion status…"
                              wrapText="true"
                              prefHeight="160"/>
                </VBox>

                <Label fx:id="formValidationLabel"
                       styleClass="validation-label"
                       wrapText="true"
                       managed="false" visible="false"/>

                <Button fx:id="submitUpdateBtn"
                        text="Post Update"
                        styleClass="btn-primary"
                        maxWidth="Infinity"
                        onAction="#handleSubmitUpdate"/>
            </VBox>
        </VBox>

    </SplitPane>

</VBox>
